{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{REPO}}/hooks/shell_guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{REPO}}/hooks/edit_checks.py\" pre",
            "timeout": 120,
            "statusMessage": "Recording lint/type baseline"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{REPO}}/hooks/edit_checks.py\" post",
            "timeout": 120,
            "statusMessage": "Formatting, linting, type-checking"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{REPO}}/hooks/untracked_check.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{REPO}}/hooks/untracked_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
